# ═══════════════════════════════════════════
# Mercado Público Dashboard — Variables de Entorno
# ═══════════════════════════════════════════
# Copia este archivo como .env.local y completa los valores
# cp .env.example .env.local

# API Mercado Público
# Solicitar ticket en: https://api.mercadopublico.cl/modules/IniciarSesion.aspx
MERCADO_PUBLICO_TICKET=

# Base de datos PostgreSQL
# Opciones gratuitas: https://neon.tech o https://supabase.com
DATABASE_URL=postgresql://user:password@host/database

# Secreto para proteger endpoint de sincronización (/api/cron/sync)
# Generar con: openssl rand -hex 32
CRON_SECRET=
